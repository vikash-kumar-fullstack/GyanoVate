<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<h1>Admin Dashboard</h1>
<div class="stats">
    <div class="stat-card">Total Lectures: <%= lectures.length %></div>
    <div class="stat-card">Teachers: <%= teachers.length %></div>
    <div class="stat-card">Today's Lectures: <%= todaysLectures.length %></div>
</div>
<div class="admin-actions">
    <a href="/admin/create-lecture" class="btn">+ New Lecture</a>
    <a href="/admin/schedules" class="btn">Manage Schedules</a>
    <a href="/admin/teachers" class="btn">Manage Teachers</a>
</div>
<h2>Recent Lectures</h2>
<table class="data-table">
    <thead><tr><th>Title</th><th>Teacher</th><th>Class</th><th>Date</th><th>Status</th></tr></thead>
    <tbody>
        <% lectures.forEach(l => { %>
        <tr>
            <td><%= l.title %></td>
            <td><%= l.teacherId ? l.teacherId.name : 'N/A' %></td>
            <td><%= l.classNum %></td>
            <td><%= l.date.toDateString() %></td>
            <td><%= l.status %></td>
        </tr>
        <% }); %>
    </tbody>
</table>
<%- include('../partials/footer') %>