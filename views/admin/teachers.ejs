<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<h1>Manage Teachers</h1>
<% if (message) { %><div class="alert success"><%= message %></div><% } %>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<form action="/admin/teachers" method="post" enctype="multipart/form-data" class="teacher-form">
    <h3>Add New Teacher</h3>
    <input type="text" name="name" placeholder="Full Name" required>
    <input type="email" name="email" placeholder="Email" required>
    <input type="password" name="password" placeholder="Password" required>
    <input type="text" name="subjects" placeholder="Subjects (comma separated)">
    <input type="text" name="classes" placeholder="Classes (comma separated)">
    <input type="file" name="profileImage" accept="image/*">
    <button type="submit">Create Teacher</button>
</form>
<table class="data-table">
    <thead><tr><th>Name</th><th>Email</th><th>Subjects</th><th>Classes</th><th>Status</th><th>Action</th></tr></thead>
    <tbody>
        <% teachers.forEach(t => { %>
        <tr>
            <td><%= t.name %></td>
            <td><%= t.email %></td>
            <td><%= t.subjects ? t.subjects.join(',') : '-' %></td>
            <td><%= t.classes ? t.classes.join(',') : '-' %></td>
            <td><%= t.isActive ? 'Active' : 'Inactive' %></td>
            <td>
                <form action="/admin/teachers/<%= t._id %>/toggle" method="post" style="display:inline">
                    <button type="submit"><%= t.isActive ? 'Deactivate' : 'Activate' %></button>
                </form>
            </td>
        </tr>
        <% }); %>
    </tbody>
</table>
<%- include('../partials/footer') %>