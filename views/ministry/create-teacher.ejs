<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<h1>Create Teacher for <%= school.name %></h1>


<form action="/ministry/schools/<%= school._id %>/teachers/create" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label>Full Name</label>
        <input type="text" name="name" required>
    </div>
    <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" required>
    </div>
    <div class="form-group">
        <label>Subjects (comma separated: Math,Science,English,Hindi,SST)</label>
        <input type="text" name="subjects" placeholder="e.g., Math,Science">
    </div>
    <div class="form-group">
        <label>Classes (comma separated: 1-10)</label>
        <input type="text" name="classes" placeholder="e.g., 5,6,7">
    </div>
    <div class="form-group">
        <label>Class Teacher Of (optional, 1-10)</label>
        <input type="number" name="classTeacherOf" min="1" max="10">
    </div>
    <div class="form-group">
        <label>Profile Image (for face recognition)</label>
        <input type="file" name="profileImage" accept="image/*">
    </div>
    <button type="submit">Create Teacher</button>
</form>

<%- include('../partials/footer') %>