<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<h1>Report for Teacher: <%= teacher.name %></h1>
<p>Period: <%= period %></p>
<h2>Attendance</h2>
<table class="data-table">
    <thead><tr><th>Date</th><th>Time</th><th>Face Match</th><th>Location Match</th><th>Verified</th></tr></thead>
    <tbody>
        <% attendance.forEach(a => { %>
        <tr>
            <td><%= a.date %></td>
            <td><%= a.time %></td>
            <td><%= a.faceMatched ? 'Yes' : 'No' %></td>
            <td><%= a.locationMatched ? 'Yes' : 'No' %></td>
            <td><%= a.verified ? 'Yes' : 'No' %></td>
        </tr>
        <% }); %>
    </tbody>
</table>
<h2>Lectures Conducted</h2>
<table class="data-table">
    <thead><tr><th>Title</th><th>Subject</th><th>Class</th><th>Date</th><th>Status</th></tr></thead>
    <tbody>
        <% lectures.forEach(l => { %>
        <tr><td><%= l.title %></td><td><%= l.subject %></td><td><%= l.classNum %></td><td><%= l.date.toDateString() %></td><td><%= l.status %></td></tr>
        <% }); %>
    </tbody>
</table>
<%- include('../partials/footer') %>