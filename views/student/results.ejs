<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<h1>My Academic Results</h1>
<table class="data-table">
    <thead><tr><th>Exam</th><th>Subject</th><th>Marks</th><th>Max Marks</th><th>Percentage</th><th>Grade</th></tr></thead>
    <tbody>
        <% academics.forEach(a => { %>
        <tr>
            <td><%= a.examName %></td>
            <td><%= a.subject %></td>
            <td><%= a.marksObtained %></td>
            <td><%= a.maxMarks %></td>
            <td><%= a.percentage %>%</td>
            <td><%= a.grade %></td>
        </tr>
        <% }); %>
    </tbody>
</table>
<%- include('../partials/footer') %>