<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<!-- Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
  .lecture-container {
    max-width: 900px;
    margin: 30px auto;
  }
  .page-title {
    font-size: 2rem;
    margin-bottom: 5px;
    color: #2c3e50;
  }
  .badge {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-right: 8px;
    margin-bottom: 8px;
  }
  .badge-subject { background: #3498db; color: #fff; }
  .badge-class { background: #e67e22; color: #fff; }
  .badge-status {
    background: <%- lecture.status === 'completed' ? '#2ecc71' : (lecture.status === 'analyzed' ? '#9b59b6' : '#f1c40f') %>;
    color: #fff;
  }

  .info-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    margin: 25px 0;
  }
  .info-card {
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .info-card i {
    font-size: 1.8rem;
    color: #3498db;
    width: 40px;
    text-align: center;
  }
  .info-card .label {
    font-size: 0.85rem;
    color: #7f8c8d;
    margin-bottom: 2px;
  }
  .info-card .value {
    font-weight: 700;
    color: #2c3e50;
  }

  .section-card {
    background: #fff;
    border-radius: 12px;
    padding: 25px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    margin-bottom: 20px;
  }
  .section-card h3 {
    margin-top: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #2c3e50;
    border-bottom: 2px solid #ecf0f1;
    padding-bottom: 10px;
  }
  .section-card h3 i {
    color: #3498db;
  }

  details {
    margin-top: 15px;
    background: #f8f9fa;
    border-radius: 8px;
    padding: 15px;
    cursor: pointer;
  }
  details summary {
    font-weight: 600;
    color: #2c3e50;
    outline: none;
  }
  details pre {
    white-space: pre-wrap;
    word-wrap: break-word;
    max-height: 300px;
    overflow-y: auto;
    background: #ecf0f1;
    padding: 12px;
    border-radius: 8px;
    margin-top: 10px;
    font-size: 0.9rem;
  }

  .analysis-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 15px;
  }
  .analysis-item {
    background: #f8f9fa;
    border-radius: 10px;
    padding: 20px;
    text-align: center;
  }
  .analysis-item .big-number {
    font-size: 2rem;
    font-weight: 700;
    color: #2c3e50;
  }
  .analysis-item .label {
    color: #7f8c8d;
    font-size: 0.9rem;
  }

  audio {
    width: 100%;
    margin: 15px 0;
    border-radius: 30px;
  }

  .btn-link {
    display: inline-block;
    background: #3498db;
    color: #fff;
    padding: 8px 18px;
    border-radius: 20px;
    text-decoration: none;
    margin: 5px 0;
    transition: background 0.2s;
  }
  .btn-link:hover { background: #2980b9; }

  @media (max-width: 600px) {
    .info-cards { grid-template-columns: 1fr; }
    .analysis-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="lecture-container">
  <h1 class="page-title"><%= lecture.title %></h1>
  <div>
    <span class="badge badge-subject"><i class="fas fa-book"></i> <%= lecture.subject %></span>
    <span class="badge badge-class"><i class="fas fa-chalkboard"></i> Class <%= lecture.classNum %></span>
    <span class="badge badge-status"><i class="fas fa-circle"></i> <%= lecture.status %></span>
  </div>

  <!-- Quick Information Cards -->
  <div class="info-cards">
    <div class="info-card">
      <i class="fas fa-calendar-alt"></i>
      <div>
        <div class="label">Date</div>
        <div class="value"><%= lecture.date?.toDateString() || 'Not set' %></div>
      </div>
    </div>
    <div class="info-card">
      <i class="fas fa-clock"></i>
      <div>
        <div class="label">Time</div>
        <div class="value"><%= lecture.startTime || '?' %> - <%= lecture.endTime || '?' %></div>
      </div>
    </div>
    <div class="info-card">
      <i class="fas fa-tag"></i>
      <div>
        <div class="label">Topic</div>
        <div class="value"><%= lecture.topic %></div>
      </div>
    </div>
  </div>

  <!-- Reference Video Section -->
 
  <div class="section-card">
    <h3><i class="fab fa-youtube"></i> Reference Video</h3>
    <a href="<%= lecture.youtubeVideo.url %>" target="_blank" class="btn-link">
      <i class="fas fa-external-link-alt"></i> Watch on YouTube
    </a>
    <% if (lecture.youtubeVideo.transcript) { %>
      <details>
        <summary>View Reference Transcript</summary>
        <pre><%= lecture.youtubeVideo.transcript %></pre>
      </details>
    <% } %>
  </div>
  

  <!-- Recording Section -->
  <% if (lecture.recording?.audioUrl) { %>
  <div class="section-card">
    <h3><i class="fas fa-microphone-alt"></i> Lecture Recording</h3>
    <audio controls src="<%= lecture.recording.audioUrl %>"></audio>
    <% if (lecture.recording.transcript) { %>
      <details>
        <summary>Show Recorded Transcript</summary>
        <pre><%= lecture.recording.transcript %></pre>
      </details>
    <% } %>
  </div>
  <% } %>

  <!-- AI Analysis Section -->
  <div class="section-card">
    <h3><i class="fas fa-robot"></i> AI Analysis</h3>
    <% if (lecture.analysis?.transcriptMatchPercentage != null) { %>
      <div class="analysis-grid">
        <div class="analysis-item">
          <div class="big-number"><%= lecture.analysis.transcriptMatchPercentage %>%</div>
          <div class="label">Content Match</div>
        </div>
        <div class="analysis-item">
          <div class="big-number"><%= (lecture.analysis.humanVoiceProbability * 100).toFixed(1) %>%</div>
          <div class="label">Human Voice Probability</div>
        </div>
      </div>
      <details>
        <summary>View Complete Analysis JSON</summary>
        <pre><%= JSON.stringify(lecture.analysis.grokAnalysis, null, 2) %></pre>
      </details>
    <% } else { %>
      <div style="text-align:center; padding:30px; color:#7f8c8d;">
        <i class="fas fa-hourglass-half fa-3x" style="margin-bottom:15px; display:block;"></i>
        <p>No analysis data available yet.</p>
      </div>
    <% } %>
  </div>

  <div style="text-align:center; margin-top:30px;">
    <a href="/principal/dashboard" class="btn-link"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
  </div>
</div>

<%- include('../partials/footer') %>