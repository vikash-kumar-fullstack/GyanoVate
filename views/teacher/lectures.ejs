<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<h1>My Lectures</h1>
<table class="data-table">
    <thead><tr><th>Title</th><th>Subject</th><th>Topic</th><th>video</th><th>Class</th><th>Date</th><th>Time</th><th>Status</th><th>Analysis</th></tr></thead>
    <tbody>
        <% lectures.forEach(l => { %>
        <tr>
            <td><%= l.title %></td>
            <td><%= l.subject %></td>
            <td><%= l.topic %></td>
             <td><%= l. youtubeVideo.url %></td>
            
            <td><%= l.classNum %></td>
            <td><%= l.date.toDateString() %></td>
            <td><%= l.startTime %>-<%= l.endTime %></td>
            <td><%= l.status %></td>
            <td><a href="/teacher/lectures/<%= l._id %>">Details</a></td>
        </tr>
        <% }); %>
    </tbody>
</table>
<%- include('../partials/footer') %>